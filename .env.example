FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=
# Any litellm model string. Put the matching key in the env var litellm expects:
#   gemini/gemini-2.0-flash -> GEMINI_API_KEY    | gpt-4o-mini -> OPENAI_API_KEY    | anthropic/claude-sonnet-4-5 -> ANTHROPIC_API_KEY
LLM_MODELS=gemini/gemini-3.7-flash,gemini/gemini-3.6-flash   # comma-separated fallback chain
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# short path for cloned histories (Windows MAX_PATH)
CLONE_DIR=data/clones
